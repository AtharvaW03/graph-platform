# Indexer runtime state - clones, graphify outputs, state file
workdir/
graphify-out/

# Local operator configs. AGENTS.md documents "*.local.yaml" as the
# convention, so match the whole pattern rather than one filename - an
# operator config named anything else (repos.docker.local.yaml, a
# per-team manifest) is just as likely to carry internal repo URLs.
config/*.local.yaml

# Local env files (never commit tokens/passwords)
.env

# Secrets that must never be committed - the GitHub App private key especially
# (it grants read to every private repo the App is installed on)
*.pem
*.key

# Built binaries when `go build` is run without -o
/indexer
/importer
/query-service
/mcp-server

# Compiled binaries + editor backups
*.exe
*.exe~
*~

# OS / editor noise
.DS_Store
*.swp
*.log

# graphify: skip test artifacts + fixtures
workdir-test/
sample-data/
.claude/

/bin

