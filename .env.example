# Copy to .env (compose reads it automatically) and fill in real values.
# Never commit the real .env.

# Required. Becomes NEO4J_AUTH=neo4j/${NEO4J_PASSWORD} for the neo4j
# container and NEO4J_PASSWORD for query-service/indexer.
NEO4J_PASSWORD=changeme

# Optional. Bearer token query-service requires on every route but /health.
# Empty disables auth. The web container injects this into the Authorization
# header server-side (nginx) - it is never shipped in the JS bundle.
QUERY_AUTH_TOKEN=

# Bearer token the hosted mcp-server requires on incoming MCP connections
# (/health stays open). Separate from QUERY_AUTH_TOKEN: this one is
# distributed to every engineer's Claude Code config, that one never leaves
# the deployment. In HTTP mode, an empty token is allowed only on a loopback
# address; on any reachable address the server refuses to start unless
# MCP_ALLOW_NO_AUTH is also set (see below).
MCP_AUTH_TOKEN=

# Escape hatch: set to 1 to run the HTTP mcp-server unauthenticated on a
# non-loopback address (e.g. behind a boundary that authenticates for you).
# Leave empty in normal deployments - an empty MCP_AUTH_TOKEN then fails
# closed instead of silently exposing the graph.
MCP_ALLOW_NO_AUTH=

# Optional. Set to 1 to let the hosted mcp-server accept per-user API keys
# (a1kg_... values minted by the /portal page) alongside MCP_AUTH_TOKEN.
# Keys are validated through query-service and expire at the start of every
# calendar month.
MCP_USER_KEYS=

# Optional, all four together: enables the self-service key portal at
# /portal on query-service (proxied by web without token injection). The
# values come from an OIDC app registration in the org's identity provider
# (Entra ID: issuer is https://login.microsoftonline.com/<tenant-id>/v2.0,
# redirect URL is https://<host>/portal/callback). Nothing here is
# Microsoft-specific - any standards-compliant OIDC issuer works.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=

# Required when OIDC_* is set: signs the portal's session cookies.
# Generate with: openssl rand -hex 32
PORTAL_SESSION_SECRET=

# Required when the indexer runs with --webhook-addr. HMAC secret GitHub
# signs every delivery with (X-Hub-Signature-256); set the same value in the
# GitHub webhook config. Unsigned deliveries are rejected.
GITHUB_WEBHOOK_SECRET=

# Optional. Bearer token for the webhook-mode indexer's /status endpoint
# (per-repo last-indexed commit and pending re-indexes). Empty disables auth.
INDEXER_STATUS_TOKEN=

# Optional. GitHub PAT for the indexer to clone private repos over HTTPS.
# Public repos work with this unset. Ignored if the GITHUB_APP_* vars below
# are set - GitHub App auth takes precedence when configured.
GIT_TOKEN=

# Optional, all three together. GitHub App auth for the indexer, preferred
# over GIT_TOKEN where available (short-lived installation tokens instead of
# a long-lived PAT). Leave all three empty to use GIT_TOKEN instead.
# Also required for `discovery.enabled: true` in the indexer config, which
# turns the App installation itself into the repo manifest (install the App
# on a repo to index it, uninstall to retire it).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
