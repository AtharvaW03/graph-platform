server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # The self-service key portal. It authenticates browsers itself (OIDC
    # session cookies), so this proxies WITHOUT injecting the internal bearer
    # token - the portal must never be reachable with service credentials a
    # browser didn't earn. No /api prefix strip: portal routes live at
    # /portal on query-service directly.
    location /portal {
        proxy_pass ${QUERY_SERVICE_URL};
        proxy_set_header Host $host;
    }

    # Strips /api to match vite.config.ts's dev proxy rewrite, and injects
    # the bearer token server-side so it never reaches the browser bundle.
    # GET/HEAD only: the query API is entirely read-only, so the injected
    # token cannot be ridden into any write path the API might grow later.
    location /api/ {
        limit_except GET {
            deny all;
        }
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass ${QUERY_SERVICE_URL};
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer ${QUERY_AUTH_TOKEN}";
    }
}
